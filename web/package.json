{
  "name": "freegames-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/legal.mjs && node scripts/seo.mjs && node scripts/downloads.mjs",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 $(ls test/*.test.ts games/*/test/*.test.ts | grep -v '^games/freecol/')",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "capnp-es": "0.0.16",
    "fflate": "0.8.2",
    "jpeg-js": "0.4.4",
    "jquery": "3.7.1",
    "jquery-color": "3.0.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/jquery": "3.5.34",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "puppeteer-core": "25.14.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
