        dat     #1 && 2 || 0, #!5
        dat     #(1<2)+(2>1)+(1<=1)+(1>=2)+(1==1)+(1!=1), #-(-3)
        dat     #a=5, #a*2
        dat     #7-3-2, #100/10/5
