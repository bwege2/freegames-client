;redcode-94
;name Expressions
;assert 1
        dat     #1/0, #1
        dat     #1%0, #1
        dat     #((1), #1
        dat     #9223372036854775807+1, #2
        dat     #99999999999999999999, #3
        dat     #3*4000000000000000000, #4
        dat     #-9223372036854775807-2, #5
        dat     #1 && 2 || 0, #!5
        dat     #(1<2)+(2>1)+(1<=1)+(1>=2)+(1==1)+(1!=1), #-(-3)
        dat     #a=5, #a*2
