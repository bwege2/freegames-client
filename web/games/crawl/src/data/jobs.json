[{"id":"JOB_AIR_ELEMENTALIST","name":"Air Elementalist","abbr":"AE","category":"Mage","stats":[0,7,5],"equipment":["robe","potion of magic"],"spells":["SPELL_SHOCK","SPELL_DISCHARGE","SPELL_SWIFTNESS","SPELL_AIRSTRIKE"],"skills":{"dodging":2,"stealth":2,"spellcasting":2,"conjurations":1,"air_magic":3},"weaponChoice":"none","recommendedSpecies":["deep elf","tengu","draconian","naga","vine stalker","djinni"],"description":"Air Elementalists have learned the Shock spell. Their electrical magic can harm\ngroups of foes, while their air spells assist in fighting or fleeing enemies.","_source":"crawl-ref/source/dat/jobs/air-elementalist.yaml"},{"id":"JOB_ALCHEMIST","name":"Alchemist","abbr":"Al","category":"Mage","stats":[0,7,5],"equipment":["robe","potion of magic"],"spells":["SPELL_POISONOUS_VAPOURS","SPELL_MERCURY_ARROW","SPELL_MEPHITIC_CLOUD","SPELL_OLGREBS_TOXIC_RADIANCE","SPELL_STICKY_FLAME"],"skills":{"dodging":2,"stealth":2,"spellcasting":2,"conjurations":1,"alchemy":3},"weaponChoice":"none","recommendedSpecies":["deep elf","spriggan","naga","merfolk","octopode","djinni","demonspawn"],"description":"Alchemists start with the Poisonous Vapours spell, and their magic is very\neffective against foes susceptible to poison.","_source":"crawl-ref/source/dat/jobs/alchemist.yaml"},{"id":"JOB_ARTIFICER","name":"Artificer","abbr":"Ar","category":"Adventurer","stats":[4,3,5],"equipment":["club","leather armour","wand of flame charges:15","wand of charming charges:15 no_exclude","wand of iceblast charges:5 no_exclude"],"spells":[],"skills":{"fighting":1,"armour":1,"dodging":1,"stealth":1,"evocations":3},"weaponChoice":"none","recommendedSpecies":["kobold","spriggan","draconian","demonspawn","coglin"],"description":"Artificers start with a few magic wands and a club. They'll need to find better\nweapons and armour before their wands run out.","_source":"crawl-ref/source/dat/jobs/artificer.yaml"},{"id":"JOB_BERSERKER","name":"Berserker","abbr":"Be","category":"Zealot","stats":[9,-1,4],"equipment":["animal skin"],"spells":[],"skills":{"fighting":3,"dodging":2,"weapon":3},"weaponChoice":"plain","recommendedSpecies":["mountain dwarf","oni","merfolk","minotaur","gargoyle","armataur"],"description":"Berserkers believe in Trog, the magic-hating god of frenzy. Not much can stop a\nraging berserker early on, apart from hubris.","_source":"crawl-ref/source/dat/jobs/berserker.yaml"},{"id":"JOB_BRIGAND","name":"Brigand","abbr":"Br","category":"Warrior","stats":[3,3,6],"equipment":["dagger plus:2","robe","cloak","dart ego:poisoned q:9","dart ego:curare q:3"],"spells":[],"skills":{"fighting":2,"dodging":1,"stealth":4,"throwing":2,"weapon":2},"weaponChoice":"none","recommendedSpecies":["troll","spriggan","demonspawn","vine stalker","gnoll"],"description":"Brigands carry poisoned darts and a small number of nasty curare darts.","_source":"crawl-ref/source/dat/jobs/brigand.yaml"},{"id":"JOB_CHAOS_KNIGHT","name":"Chaos Knight","abbr":"CK","category":"Zealot","stats":[4,4,4],"equipment":["leather armour plus:2","scroll of butterflies no_exclude"],"spells":[],"skills":{"fighting":3,"dodging":1,"armour":1,"weapon":3},"weaponChoice":"plain","recommendedSpecies":["spriggan","troll","gnoll","merfolk","minotaur","draconian","demonspawn"],"description":"Chaos Knights are playthings of the unpredictable Xom, and are subject to the\ngod's constantly changing moods.","_source":"crawl-ref/source/dat/jobs/chaos-knight.yaml"},{"id":"JOB_CINDER_ACOLYTE","name":"Cinder Acolyte","abbr":"CA","category":"Zealot","stats":[6,6,0],"equipment":["robe"],"spells":["SPELL_SCORCH"],"skills":{"fighting":3,"weapon":3,"spellcasting":1,"fire_magic":3},"weaponChoice":"plain","recommendedSpecies":["mountain dwarf","draconian","oni","djinni","gnoll"],"description":"Cinder Acolytes worship Ignis, drawing upon the flame of a dying god until\nthere is nothing left. They have both melee and fire magic capabilities.","_source":"crawl-ref/source/dat/jobs/cinder-acolyte.yaml"},{"id":"JOB_CONJURER","name":"Conjurer","abbr":"Cj","category":"Mage","stats":[-1,10,3],"equipment":["robe","potion of magic"],"spells":["SPELL_MAGIC_DART","SPELL_SEARING_RAY","SPELL_FULMINANT_PRISM","SPELL_ISKENDERUNS_MYSTIC_BLAST"],"skills":{"dodging":2,"spellcasting":2,"conjurations":4,"stealth":2},"weaponChoice":"none","recommendedSpecies":["deep elf","naga","tengu","draconian","demigod","djinni","armataur"],"description":"Conjurers begin with the Magic Dart spell, and can learn other non-elemental\nspells to reliably blast their foes.","_source":"crawl-ref/source/dat/jobs/conjurer.yaml"},{"id":"JOB_DELVER","name":"Delver","abbr":"De","category":"Adventurer","stats":[4,2,6],"equipment":["leather armour","scroll of fog","scroll of revelation","scroll of fear","potion of haste","wand of digging charges:3"],"spells":[],"skills":{"fighting":3,"dodging":2,"stealth":5,"weapon":2},"weaponChoice":"plain","recommendedSpecies":["felid","spriggan","kobold","gnoll"],"description":"Delvers start their quest five levels below the surface. A set of powerful magic\nitems helps them survive the dangerous journey upward.","_source":"crawl-ref/source/dat/jobs/delver.yaml"},{"id":"JOB_EARTH_ELEMENTALIST","name":"Earth Elementalist","abbr":"EE","category":"Mage","stats":[0,7,5],"equipment":["robe","potion of magic"],"spells":["SPELL_SANDBLAST","SPELL_PASSWALL","SPELL_STONE_ARROW","SPELL_PETRIFY","SPELL_BOULDER"],"skills":{"dodging":2,"stealth":2,"spellcasting":2,"conjurations":1,"earth_magic":3},"weaponChoice":"none","recommendedSpecies":["deep elf","spriggan","gargoyle","demigod","octopode","revenant"],"description":"Earth Elementalists know the Sandblast spell, and can later learn more earthen\nspells suitable for subtle stabbing or brute-force blasting.","_source":"crawl-ref/source/dat/jobs/earth-elementalist.yaml"},{"id":"JOB_ENCHANTER","name":"Enchanter","abbr":"En","category":"Warrior-mage","stats":[0,7,5],"equipment":["dagger plus:1","robe","potion of invisibility q:2"],"spells":["SPELL_HIBERNATION","SPELL_CONFUSING_TOUCH","SPELL_TUKIMAS_DANCE","SPELL_GLOOM"],"skills":{"dodging":2,"spellcasting":2,"hexes":3,"stealth":3,"weapon":1},"weaponChoice":"none","recommendedSpecies":["deep elf","felid","kobold","spriggan","naga","poltergeist"],"description":"Enchanters know a variety of Hexes that can incapacitate their foes, and are\nequipped with an enchanted dagger and potions of invisibility.","_source":"crawl-ref/source/dat/jobs/enchanter.yaml"},{"id":"JOB_FIGHTER","name":"Fighter","abbr":"Fi","category":"Warrior","stats":[8,0,4],"equipment":["scale mail","buckler","potion of might q:2"],"spells":[],"skills":{"fighting":3,"armour":3,"shields":3,"weapon":2},"weaponChoice":"good","recommendedSpecies":["mountain dwarf","troll","minotaur","gargoyle","armataur","formicid","revenant"],"description":"Fighters are equipped with armour and shield, as well as a weapon of their\nchoice and potions of might.","_source":"crawl-ref/source/dat/jobs/fighter.yaml"},{"id":"JOB_FIRE_ELEMENTALIST","name":"Fire Elementalist","abbr":"FE","category":"Mage","stats":[0,7,5],"equipment":["robe","potion of magic"],"spells":["SPELL_FOXFIRE","SPELL_SCORCH","SPELL_BLASTMOTE","SPELL_INNER_FLAME","SPELL_FLAME_WAVE"],"skills":{"dodging":2,"stealth":2,"spellcasting":2,"conjurations":1,"fire_magic":3},"weaponChoice":"none","recommendedSpecies":["deep elf","mountain dwarf","naga","tengu","demigod","gargoyle","djinni"],"description":"Fire Elementalists have learned the Foxfire spell. Their other starting spells\nare likewise focused on fiery and explosive destruction.","_source":"crawl-ref/source/dat/jobs/fire-elementalist.yaml"},{"id":"JOB_FORGEWRIGHT","name":"Forgewright","abbr":"Fw","category":"Mage","stats":[2,7,3],"equipment":["mace tile:wpn_hammer wtile:hammer itemname:hammer","robe","potion of magic"],"spells":["SPELL_KINETIC_GRAPNEL","SPELL_SPIKE_LAUNCHER","SPELL_CLOCKWORK_BEE","SPELL_FORGE_BLAZEHEART_GOLEM","SPELL_FORGE_LIGHTNING_SPIRE"],"skills":{"dodging":2,"stealth":2,"spellcasting":2,"forgecraft":4},"weaponChoice":"none","recommendedSpecies":["mountain dwarf","coglin","barachi","human","vine stalker","merfolk"],"description":"Forgewrights are mages who specialise in the creation of turrets and mechanical\ncompanions to fight alongside.","_source":"crawl-ref/source/dat/jobs/forgewright.yaml"},{"id":"JOB_GLADIATOR","name":"Gladiator","abbr":"Gl","category":"Warrior","stats":[6,0,6],"equipment":["leather armour","helmet","throwing net q:3"],"spells":[],"skills":{"fighting":2,"throwing":2,"dodging":3,"weapon":3},"weaponChoice":"good","recommendedSpecies":["mountain dwarf","merfolk","minotaur","gargoyle","coglin","vine stalker"],"description":"Gladiators are ready for the arena with light armour, a weapon of their choice,\nand a few throwing weapons and nets.","_source":"crawl-ref/source/dat/jobs/gladiator.yaml"},{"id":"JOB_HEDGE_WIZARD","name":"Hedge Wizard","abbr":"HW","category":"Mage","stats":[2,6,4],"equipment":["dagger","robe","hat","potion of magic"],"spells":["SPELL_MAGIC_DART","SPELL_BLINK","SPELL_CALL_IMP","SPELL_GRAVE_CLAW","SPELL_MEPHITIC_CLOUD"],"skills":{"dodging":2,"stealth":2,"spellcasting":3,"conjurations":2,"translocations":1,"summonings":1,"necromancy":1},"weaponChoice":"none","recommendedSpecies":["deep elf","naga","draconian","octopode","human","djinni"],"description":"Hedge Wizards are magic generalists, good at using a wide variety of tools to\nfrustrate their foes and gain an edge in the battlefield.","_source":"crawl-ref/source/dat/jobs/hedge-wizard.yaml"},{"id":"JOB_HEXSLINGER","name":"Hexslinger","abbr":"Hs","category":"Warrior-mage","stats":[0,5,7],"equipment":["robe","scroll of poison","sling plus:1"],"spells":["SPELL_JINXBITE","SPELL_SIGIL_OF_BINDING","SPELL_INNER_FLAME","SPELL_CAUSE_FEAR","SPELL_DIMENSIONAL_BULLSEYE"],"skills":{"fighting":1,"dodging":2,"spellcasting":1,"hexes":3,"fire_magic":1,"weapon":2},"weaponChoice":"none","recommendedSpecies":["formicid","deep elf","kobold","spriggan","gnoll"],"description":"Hexslingers carry a sling, and use hex magic to make their foes more vulnerable\nto attacks from afar.","_source":"crawl-ref/source/dat/jobs/hexslinger.yaml"},{"id":"JOB_HUNTER","name":"Hunter","abbr":"Hu","category":"Warrior","stats":[3,1,8],"equipment":["shortbow","leather armour","scroll of butterflies no_exclude"],"spells":[],"skills":{"fighting":2,"dodging":2,"stealth":1,"weapon":4},"weaponChoice":"none","recommendedSpecies":["minotaur","gnoll","barachi","kobold","spriggan"],"description":"Hunters carry a shortbow, light armour and a scroll of butterflies.\n# TODO: fix this for coglins","_source":"crawl-ref/source/dat/jobs/hunter.yaml"},{"id":"JOB_ICE_ELEMENTALIST","name":"Ice Elementalist","abbr":"IE","category":"Mage","stats":[0,7,5],"equipment":["robe","potion of magic"],"spells":["SPELL_FREEZE","SPELL_FROZEN_RAMPARTS","SPELL_OZOCUBUS_ARMOUR","SPELL_SUMMON_ICE_BEAST"],"skills":{"dodging":2,"stealth":2,"spellcasting":2,"ice_magic":4},"weaponChoice":"none","recommendedSpecies":["merfolk","barachi","draconian","demigod","gargoyle","djinni","revenant"],"description":"Ice Elementalists begin with the Freeze spell. Their later spells provide strong\noffence and defence, but may restrict their movement.","_source":"crawl-ref/source/dat/jobs/ice-elementalist.yaml"},{"id":"JOB_MONK","name":"Monk","abbr":"Mo","category":"Warrior","stats":[3,2,7],"equipment":["robe","potion of ambrosia","orb ego:light"],"spells":[],"skills":{"fighting":3,"dodging":3,"weapon":3},"weaponChoice":"plain","recommendedSpecies":["mountain dwarf","troll","armataur","merfolk","gargoyle","demonspawn"],"description":"Monks start with a simple weapon of their choice, an orb of light, and a potion\nof divine ambrosia, and gain additional piety with the first god they worship.","_source":"crawl-ref/source/dat/jobs/monk.yaml"},{"id":"JOB_NECROMANCER","name":"Necromancer","abbr":"Ne","category":"Mage","stats":[0,7,5],"equipment":["dagger","robe","potion of magic"],"spells":["SPELL_SOUL_SPLINTER","SPELL_GRAVE_CLAW","SPELL_VAMPIRIC_DRAINING","SPELL_ANIMATE_DEAD","SPELL_CURSE_OF_AGONY"],"skills":{"dodging":2,"stealth":2,"spellcasting":2,"necromancy":4},"weaponChoice":"none","recommendedSpecies":["deep elf","djinni","mountain dwarf","demonspawn","mummy","revenant"],"description":"Necromancers start out with the Soul Splinter spell. Eventually, they can turn\nthe dead into allies and use the life force of the living to restore themselves.","_source":"crawl-ref/source/dat/jobs/necromancer.yaml"},{"id":"JOB_REAVER","name":"Reaver","abbr":"Re","category":"Warrior-mage","stats":[4,5,3],"equipment":["leather armour"],"spells":["SPELL_KISS_OF_DEATH","SPELL_MOMENTUM_STRIKE","SPELL_HAILSTORM","SPELL_RENDING_BLADE"],"skills":{"fighting":2,"dodging":2,"spellcasting":2,"conjurations":3,"weapon":3},"weaponChoice":"plain","recommendedSpecies":["gnoll","tengu","barachi","demonspawn","draconian","mountain dwarf"],"description":"Reavers start with a weapon of their choice and deadly magic to supplement it\nwhen in need. They start with the Kiss of Death spell.","_source":"crawl-ref/source/dat/jobs/reaver.yaml"},{"id":"JOB_SHAPESHIFTER","name":"Shapeshifter","abbr":"Sh","category":"Adventurer","stats":[6,2,4],"equipment":["animal skin","flux bauble q:3","potion of lignification","quill talisman","protean talisman"],"spells":[],"skills":{"fighting":2,"unarmed_combat":3,"dodging":2,"shapeshifting":3},"weaponChoice":"none","recommendedSpecies":["naga","merfolk","draconian","demigod","demonspawn","troll"],"description":"Shapeshifters use talismans to shift their form, making them powerful melee\nfighters (especially when unarmed) at the cost of armour.","_source":"crawl-ref/source/dat/jobs/shapeshifter.yaml"},{"id":"JOB_SUMMONER","name":"Summoner","abbr":"Su","category":"Mage","stats":[0,7,5],"equipment":["robe","potion of magic"],"spells":["SPELL_SUMMON_SMALL_MAMMAL","SPELL_CALL_IMP","SPELL_CALL_CANINE_FAMILIAR","SPELL_SURPRISING_CROCODILE","SPELL_SUMMON_SEISMOSAURUS_EGG"],"skills":{"dodging":2,"stealth":2,"spellcasting":2,"summonings":4},"weaponChoice":"none","recommendedSpecies":["deep elf","oni","vine stalker","merfolk","tengu"],"description":"Summoners are able to cast Summon Small Mammal from the start, and begin with\nspells to summon stronger and more exotic allies in their library.","_source":"crawl-ref/source/dat/jobs/summoner.yaml"},{"id":"JOB_WANDERER","name":"Wanderer","abbr":"Wn","category":"Adventurer","stats":[0,0,0],"equipment":[],"spells":[],"skills":{},"weaponChoice":"none","recommendedSpecies":["mountain dwarf","gnoll","merfolk","draconian","human","demonspawn","barachi"],"description":"Wanderers start with random equipment and skills.","_source":"crawl-ref/source/dat/jobs/wanderer.yaml"},{"id":"JOB_WARPER","name":"Warper","abbr":"Wr","category":"Warrior-mage","stats":[3,5,4],"equipment":["leather armour","scroll of blinking","dart ego:disjunction q:4"],"spells":["SPELL_BLINK","SPELL_BECKONING","SPELL_TELEPORT_OTHER","SPELL_PILEDRIVER","SPELL_ELECTRIC_CHARGE"],"skills":{"fighting":2,"throwing":1,"armour":1,"dodging":2,"spellcasting":2,"translocations":3,"weapon":2},"weaponChoice":"plain","recommendedSpecies":["felid","spriggan","armataur","draconian","coglin"],"description":"Warpers start with a weapon of their choice, a scroll of blinking, darts of\ndisjunction, and some Translocation spells in their library.","_source":"crawl-ref/source/dat/jobs/warper.yaml"}]
