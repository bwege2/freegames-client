      "input": "Mouse",
      "action": "Select units and colonies, give orders, open panels"
    },
    {
      "input": "Keyboard",
      "action": "Move the active unit (number pad, arrow keys); the menus' shortcuts (W: wait, F: fortify, B: build colony, Enter: end the turn)"
    }
  ],
