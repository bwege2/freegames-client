# dm: three players on dm1 fight for a minute: connect, map download, kills, chat, emoticons, weapons
duration 3000
server sv_register 0
server sv_map dm1
server sv_gametype dm
server sv_warmup 0
server sv_scorelimit 20
server sv_timelimit 0
server sv_max_clients 8
server sv_name oracle-dm
client 0 name=alice clan=red seed=11 mode=hunt country=276
client 1 name=bob seed=22 mode=hunt body=kitty marking=whisker color=1b6f74,ff0000ff,1b6f74,1b759e,1c873e,0000ff
