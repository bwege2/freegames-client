diff -ru a/src/video/dummy/SDL_nullevents.c b/src/video/dummy/SDL_nullevents.c
--- a/src/video/dummy/SDL_nullevents.c	2026-10-28 07:02:28.622937650 +0100
+++ b/src/video/dummy/SDL_nullevents.c	2026-10-28 07:02:28.623597668 +0100
@@ -31,9 +31,38 @@
 #include "SDL_nullvideo.h"
 #include "SDL_nullevents_c.h"
 
+/* Frozen Bubble oracle: the shim (LD_PRELOAD) hands over the scripted input that is due; it is
+   posted as a real driver posts what the window system reports (X11: unicode on key presses only,
+   when SDL_EnableUNICODE is on; the pointer moves before a button changes elsewhere). */
+typedef struct { int type, sym, unicode, x, y, button; } fbshim_event;
+extern int fbshim_next_event(fbshim_event *e) __attribute__((weak));
+
 void DUMMY_PumpEvents(_THIS)
 {
-	/* do nothing. */
+	fbshim_event e;
+	if ( ! fbshim_next_event ) return;
+	while ( fbshim_next_event(&e) ) {
+		SDL_keysym k;
+		int mx, my;
+		switch ( e.type ) {
+		case 1: case 2:	/* key down / up */
+			k.scancode = 0;
+			k.sym = (SDLKey)e.sym;
+			k.mod = KMOD_NONE;
+			k.unicode = (e.type == 1 && SDL_TranslateUNICODE) ? (Uint16)e.unicode : 0;
+			SDL_PrivateKeyboard(e.type == 1 ? SDL_PRESSED : SDL_RELEASED, &k);
+			break;
+		case 3:		/* motion */
+			SDL_PrivateMouseMotion(0, 0, (Sint16)e.x, (Sint16)e.y);
+			break;
+		case 4: case 5:	/* button down / up */
+			SDL_GetMouseState(&mx, &my);
+			if ( mx != e.x || my != e.y )
+				SDL_PrivateMouseMotion(0, 0, (Sint16)e.x, (Sint16)e.y);
+			SDL_PrivateMouseButton(e.type == 4 ? SDL_PRESSED : SDL_RELEASED, (Uint8)e.button, (Sint16)e.x, (Sint16)e.y);
+			break;
+		}
+	}
 }
 
